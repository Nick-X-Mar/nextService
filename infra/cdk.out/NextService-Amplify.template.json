        "",
        [
         {
          "Fn::ImportValue": "NextService-AppSync:ExportsOutputFnGetAttChatEventsApiApiId96C43684"
         },
         ".appsync-api.eu-central-1.amazonaws.com"
        ]
       ]
      }
     },
     {
      "Name": "NEXT_PUBLIC_APPSYNC_WEBSOCKET_ENDPOINT",
      "Value": {
       "Fn::Join": [
        "",
        [
         {
          "Fn::ImportValue": "NextService-AppSync:ExportsOutputFnGetAttChatEventsApiApiId96C43684"
         },
         ".appsync-realtime-api.eu-central-1.amazonaws.com"
        ]
       ]
      }
     },
     {
      "Name": "NEXT_PUBLIC_APPSYNC_API_KEY",
      "Value": {
       "Fn::ImportValue": "NextService-AppSync:ExportsOutputFnGetAttChatApiKeyApiKeyCBB19482"
      }
     },
     {
      "Name": "AMPLIFY_ROLE_ARN",
      "Value": {
       "Fn::GetAtt": [
        "AmplifyRole7A8FD9BC",
        "Arn"
       ]
      }
     }
    ],
    "IAMServiceRole": {
     "Fn::GetAtt": [
      "AmplifyRole7A8FD9BC",
      "Arn"
     ]
    },
    "Name": "nextservice-web",
    "Platform": "WEB_COMPUTE",
    "Repository": "https://github.com/Nick-X-Mar/nextService"
   },
   "Metadata": {
    "aws:cdk:path": "NextService-Amplify/NextServiceApp"
   }
  },
  "MainBranch": {
